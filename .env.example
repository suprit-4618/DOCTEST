# ==========================================
# DOCTEST Environment Configuration
# ==========================================

# AI Vision & LLM Provider: 'groq', 'gemini', or 'openai'
DEFAULT_LLM_PROVIDER=groq

# Groq Configuration (Ultra-fast inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration
DATABASE_URL=sqlite:///./mcq_selftest.db

# Storage & Ingestion Settings
STORAGE_DIR=./storage
MAX_FILE_SIZE_BYTES=26214400 # 25 MB
MAX_PAGE_COUNT=150
PDF_RENDER_DPI=150
IMAGE_MAX_DIMENSION=2000

# Optional App Access Password for Public Hosting
APP_PASSWORD=
